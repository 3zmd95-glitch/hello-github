+function sqliteStorage(db: DatabaseSync) {
+  return {
+    sql: {
+      exec(query: string, ...bindings: (string | number | null)[]) {
+        const st = db.prepare(query);
+        if (/^\s*SELECT|RETURNING/i.test(query)) {
+          const rows = st.all(...bindings);
+          return { toArray: () => rows };
+        }
+        st.run(...bindings);
+        return { toArray: () => [] };
+      },
+    },
+    transactionSync<T>(fn: () => T): T {
+      db.exec("BEGIN");
+      try {
+        const v = fn();
+        db.exec("COMMIT");
+        return v;
+      } catch (e) {
+        db.exec("ROLLBACK");
+        throw e;
+      }
+    },
+  };
