+  idx INTEGER NOT NULL,
+  action_id TEXT NOT NULL,
+  kind TEXT NOT NULL,
+  status TEXT NOT NULL,
+  output_id TEXT,
+  output_digest TEXT,
+  error TEXT,
+  at INTEGER,
