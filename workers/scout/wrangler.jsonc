// Scout Worker (build plan 1.14): TikTok / Instagram / YouTube search via Tavily + oEmbed passthrough, and
// the social connector (OAuth, daily analytics sync and auto-posting for Instagram, Threads, YouTube and TikTok).
// Secrets (set by the deploy workflow with `wrangler secret put`, never committed): TAVILY_API_KEY,
// SCOUT_TOKEN, META_APP_ID, META_APP_SECRET, THREADS_APP_ID, THREADS_APP_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, TIKTOK_CLIENT_KEY,
// TIKTOK_CLIENT_SECRET.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "3z-scout",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,https://3zmd95-glitch.github.io",
  },
  // Tokens, status and the daily rows. The id below is a placeholder: the deploy workflow creates the
  // namespace "3z-scout-SOCIAL_KV" once and swaps the real id in before `wrangler deploy` (see
  // .github/workflows/worker.yml). Locally, `wrangler dev` uses a simulated namespace, no id needed.
  "kv_namespaces": [{ "binding": "SOCIAL_KV", "id": "00000000000000000000000000000000" }],
  // One trigger every five minutes: the auto-post queue publishes what is due, and the 03:00/03:10/03:20/03:30
  // UTC ticks (06:00–06:30 Riyadh) run the daily sync of one platform each instead (src/social/cron.ts).
  "triggers": { "crons": ["*/5 * * * *"] },
}
